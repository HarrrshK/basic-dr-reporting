# Production Supabase PostgreSQL connection (Render API and SQLite import destination).
# In Supabase: Project → Connect → Session pooler (or direct connection).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
API_ACCESS_TOKEN=use-the-generated-render-value
CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# Laptop-only backup agent. Keep this database separate from Supabase.
REMOTE_API_URL=https://your-render-service.onrender.com/api
BACKUP_DATABASE_URL=postgresql://postgres:<local-password>@127.0.0.1:5432/dr_reporting
BACKUP_INTERVAL_SECONDS=300
BACKUP_BATCH_SIZE=500
BACKUP_LOCAL_DIR=backups
POSTGRES_DB=dr_reporting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_PORT=5432

# S3-compatible JSON backup settings are secrets/configuration on Render.
