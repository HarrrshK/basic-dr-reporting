# Laptop sync-agent database. Render uses its persistent SQLite disk instead.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=dr_reporting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_CONNECT_TIMEOUT=3
API_ACCESS_TOKEN=copy-the-value-from-render
REMOTE_API_URL=https://your-render-api.onrender.com/api
LAPTOP_AGENT_POLL_SECONDS=3
# On Render set DATABASE_URL and SQLITE_QUEUE_URL to the same file on the persistent disk.
SQLITE_QUEUE_URL=sqlite:///./offline_queue.db
SYNC_POLL_SECONDS=2
SYNC_BATCH_SIZE=50
SYNC_MAX_BACKOFF_SECONDS=300
CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# Tests or exceptional deployments may override the permanent database URL:
# DATABASE_URL=postgresql+psycopg://postgres:password@127.0.0.1:5432/dr_reporting
